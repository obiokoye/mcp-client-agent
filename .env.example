# gemini | groq | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=

# Run with scripted AI replies and no API key (also automatic when no key is set)
DEMO_MODE=false

# Which MCP servers to connect to (Claude Desktop "mcpServers" format)
MCP_CONFIG=servers.json
